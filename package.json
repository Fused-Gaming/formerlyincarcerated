{
  "name": "bitcoin-land-bond",
  "version": "1.0.0",
  "description": "Bitcoin Land Bond - Criminal Asset Recovery Initiative for Reentry Housing",
  "homepage": "https://formerlyincarcerated.org",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "export": "next export",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:deployment": "npm run build && npm run test",
    "lint": "eslint . --ext .js,.jsx",
