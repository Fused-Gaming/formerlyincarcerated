    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "autoprefixer": "10.4.20",
    "eslint": "8.56.0",
    "eslint-config-next": "15.2.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "8.4.45",
    "tailwindcss": "3.4.14"
